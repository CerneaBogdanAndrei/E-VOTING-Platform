# Copiază în .env și completează: cp .env.example .env
# Cheia HMAC pentru CNP: openssl rand -hex 32
CNP_HMAC_KEY=
# Token-ul comisiei („rădăcina”; membrii se creează din panou): openssl rand -hex 24
ADMIN_TOKEN=
# Cheia sesiunilor alegătorilor (altfel se generează la fiecare pornire): openssl rand -hex 32
SESSION_SECRET=
# Baza de date: Supabase (Connect → Session pooler → URI). Necompletat = PostgreSQL local din Docker.
# DATABASE_URL=postgresql://postgres.<ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Cu Supabase, conexiunea trebuie criptată: DATABASE_SSL=on (implicit off, pentru baza locală din Docker)
# DATABASE_SSL=on
POSTGRES_PASSWORD=evoting
# Adresa site-ului prin Caddy (certificat local pentru localhost; un domeniu real primește Let's Encrypt)
SITE_ADDRESS=localhost
# Adresa API-ului văzută din browser (pentru build-ul web); prin Caddy e /api pe același host
PUBLIC_API_URL=https://localhost/api
# Originile permise pentru CORS
CORS_ORIGINS=https://localhost,http://localhost:8080
# Generează un PKI de test pentru cipuri NFC simulate (doar demo)
GENERATE_TEST_PKI=true
