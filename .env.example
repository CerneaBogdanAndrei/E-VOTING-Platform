# Copiază în .env și completează: cp .env.example .env
# Cheia HMAC pentru CNP: openssl rand -hex 32
CNP_HMAC_KEY=
# Token-ul comisiei: openssl rand -hex 24
ADMIN_TOKEN=
POSTGRES_PASSWORD=evoting
# Adresa API-ului văzută din browser (pentru build-ul web)
PUBLIC_API_URL=http://localhost:3000
# Generează un PKI de test pentru cipuri NFC simulate (doar demo)
GENERATE_TEST_PKI=true
