{
  "name": "@evoting/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS: înregistrare, autentificare, bulletin board, numărare. Stocare abstractizată (în memorie acum, PostgreSQL ulterior).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --enable-source-maps dist/main.js",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --enable-source-maps --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@evoting/api": "1.0.0",
    "@evoting/crypto": "1.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "asn1js": "^3.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "pkijs": "^3.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1"
  }
}
