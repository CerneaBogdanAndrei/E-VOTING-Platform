# Copiază în apps/backend/.env și completează. Fișierul .env nu se urcă pe GitHub.

PORT=3000

# Cheia HMAC pentru CNP (64 de caractere hex). Generare: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NU o pierde: fără ea, amprentele CNP din baza de date nu mai pot fi comparate.
CNP_HMAC_KEY=

# Parola comisiei pentru panoul web
ADMIN_PASSWORD=

# PostgreSQL (de exemplu Supabase). Gol = stocare în memorie.
# Supabase: Project Settings → Database → Connection string → URI (Session pooler, port 5432)
# DATABASE_URL=postgresql://postgres.<ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=on

# Fără bază de date: salvează stocarea în memorie într-un fișier, ca să nu se piardă la repornire
# DATA_FILE=./data/evoting.json

# Unelte de demo în panoul comisiei și în aplicație (NU în producție)
DEMO_MODE=true

# Certificatele CSCA (PEM/DER) pentru Passive Authentication la NFC
# CSCA_DIR=./csca

# Rate limiting (oprit doar pentru simulări de încărcare)
RATE_LIMIT=on
