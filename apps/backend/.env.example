# Conexiunea la PostgreSQL
DATABASE_URL=postgres://evoting:evoting@localhost:5432/evoting
# Supabase: Connect → Session pooler → URI (port 5432). SSL se activează automat; DATABASE_SSL=off îl oprește.
# DATABASE_URL=postgresql://postgres.<ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cheia HMAC pentru CNP (32 de octeți, hex). Generare: openssl rand -hex 32
# Nu se pune niciodată în baza de date; pierderea ei face lista de eligibili inutilizabilă.
CNP_HMAC_KEY=

# Token-ul comisiei pentru rutele de administrare. Generare: openssl rand -hex 24
ADMIN_TOKEN=

# Cheia pentru semnarea sesiunilor alegătorilor (opțional; implicit se generează la pornire)
# SESSION_SECRET=

# Directorul cu certificatele CSCA de încredere (PEM sau DER) pentru Passive Authentication
CSCA_DIR=./pki/csca

PORT=3000
# Originile permise pentru CORS, separate prin virgulă (implicit: toate)
# CORS_ORIGINS=http://localhost:5173

# off = fără limitare de rată (doar pentru simulări de încărcare)
# RATE_LIMIT=on
