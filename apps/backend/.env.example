# Conexiunea la PostgreSQL
DATABASE_URL=postgres://evoting:evoting@localhost:5432/evoting
# Supabase: Connect → Session pooler → URI (port 5432). SSL se activează automat; DATABASE_SSL=off îl oprește.
# DATABASE_URL=postgresql://postgres.<ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cheia HMAC pentru CNP (32 de octeți, hex). Generare: openssl rand -hex 32
# Nu se pune niciodată în baza de date; pierderea ei face lista de eligibili inutilizabilă.
CNP_HMAC_KEY=

# Token-ul comisiei pentru rutele de administrare. Generare: openssl rand -hex 24
ADMIN_TOKEN=

# Cheia pentru semnarea sesiunilor alegătorilor (recomandat; implicit se generează la fiecare pornire,
# deci o repornire anulează sesiunile în curs, iar mai multe instanțe nu și-ar recunoaște sesiunile)
# SESSION_SECRET=

# Directorul cu certificatele CSCA de încredere (PEM sau DER) pentru Passive Authentication
CSCA_DIR=./pki/csca

PORT=3000
# Originile permise pentru CORS, separate prin virgulă (implicit: toate; în producție serverul avertizează)
# CORS_ORIGINS=http://localhost:5173

# off = fără limitare de rată (doar pentru simulări de încărcare)
# RATE_LIMIT=on
# Câte cereri pe minut, per IP, au voie rutele sensibile (autentificare, înregistrare, token-uri)
# SENSITIVE_RATE_LIMIT=30

# La câte milisecunde închide serverul scrutinele ajunse la ora închiderii (0 = niciodată)
# AUTO_CLOSE_INTERVAL_MS=60000

# Câte proxy-uri sunt în fața serverului (Caddy, nginx), ca IP-ul real să vină din X-Forwarded-For
# TRUST_PROXY=1

# SSL spre baza de date: implicit pornit pentru orice server care nu e local; on/off îl forțează
# DATABASE_SSL=on
# Certificatul CA al furnizorului (PEM, cu \n pe un singur rând); cu el, identitatea bazei se verifică
# DATABASE_CA=

# production pornește avertismentele de configurare (CORS deschis, SESSION_SECRET lipsă)
# NODE_ENV=production
