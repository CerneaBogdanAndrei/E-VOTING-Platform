{
  "expo": {
    "name": "Vot verificabil",
    "slug": "vot-verificabil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.udjg.evoting"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ro.udjg.evoting",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera citește zona MRZ a buletinului. Imaginea se procesează doar pe telefon.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-packaging-excludes"
    ],
    "scheme": "evote",
    "experiments": {
      "typedRoutes": true
    }
  }
}
