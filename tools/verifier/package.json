{
  "name": "@evoting/verifier",
  "version": "1.0.0",
  "private": true,
  "description": "Verificatorul public: descarcă registrul scrutinului și verifică tot, fără drepturi speciale",
  "type": "module",
  "bin": { "evoting-verify": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@evoting/api": "1.0.0",
    "@evoting/crypto": "1.0.0"
  },
  "devDependencies": { "@types/node": "^22.10.0" }
}
