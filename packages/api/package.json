{
  "name": "@evoting/api",
  "version": "1.0.0",
  "private": true,
  "description": "Contractul HTTP (tipuri) și clientul API, comune backend-ului, web-ului, aplicației mobile și CLI-urilor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
